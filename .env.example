# Copia a .env y rellena los valores.
PORT=3500

# Proxy de Vite (`npm run dev` / `npm run preview`) y `npm start`: origen del ChartMuseum sin /api al final.
# Preferir 127.0.0.1 si localhost falla por IPv6
CHARTMUSEUM_BASE_URL=http://127.0.0.1:8080
CHARTMUSEUM_USER=
CHARTMUSEUM_PASSWORD=
# Opcional (multitenancy ChartMuseum): p. ej. org1/repoa
CHARTMUSEUM_REPO_PATH=

# Solo `npm start` (server/server.mjs): login de Google.
# URL pública; el callback es PUBLIC_URL + /auth/callback y tiene que estar dado de alta en el cliente OAuth.
PUBLIC_URL=http://localhost:3500
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Al menos 32 bytes aleatorios: openssl rand -base64 48
SESSION_SECRET=
ALLOWED_DOMAIN=billin.eu
ALLOWED_GROUP=backoffice@billin.eu
SESSION_TTL_SECONDS=3600
